<!DOCTYPE html>
<html>
<head>
    <title>My Portfolio</title>
<style>
    .wd{
        background-color: bisque;
        background-image: url(https://pngmagic.com/webp_images/hero-background-design-for-personal-portfolio-website_KQG.webp);
    }
</style>
</head>
<body class="wd">
    <header>
        <nav>
            <h2 class="logo">My Portfolio</h2>
            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#skills">Skills</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <section id="home" class="hero">
        <div class="hero-text">
            <h1>Hello, I'm <span>Mithin</span></h1>
            <h2>Web Developer</h2>
            <p>I create simple, modern & attractive
            websites using HTML & CSS</p>
            <button>Explore My Work</button>
        </div>
    </section>

    <section id="about">
        <h2>About Me</h2>
        <p>I am a student interested in web development
        and technology. I enjoy learning new skills
        & creating creative websites</p>
    </section>

    <section id="skills">
        <h2>My Skills</h2>
        <div class="skills-container">
            <div class="card">
                <h3>HTML</h3>
                <p>Creating the structure of websites</p>
            </div>

            <div class="card">
                <h3>Web Design</h3>
                <p>Creating simple & user-friendly interface</p>
            </div>
        </div>
    </section>

    <section id="contact">
        <h2>Contact Me</h2>
        <form>
            <input type="text" placeholder="Your Name">
            <input type="email" placeholder="Your Email">
            <textarea placeholder="Your Message"></textarea>
            <button type="submit">Send Message</button>
        </form>
    </section>

    <footer>
        <p>© 2026 My Portfolio | All Rights Reserved</p>
    </footer>

</body>
</html>
