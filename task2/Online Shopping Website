
<!DOCTYPE html>
<html>
<head>
    <title>My E-Commerce Store</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
        }

        nav {
            background-color: #222;
            color: white;
            padding: 15px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        nav h2 {
            color: orange;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 10px;
        }

        nav a:hover {
            color: orange;
        }

        .search input {
            padding: 8px;
            border-radius: 5px;
            border: none;
        }

        .banner {
            background: linear-gradient(90deg, #ff9800, #ff5722);
            color: white;
            text-align: center;
            padding: 45px 20px;
        }

        .banner h1 {
            font-size: 35px;
            margin-bottom: 10px;
        }

        .banner p {
            font-size: 18px;
        }

        .banner button {
            padding: 12px 25px;
            background: white;
            color: #ff5722;
            border: none;
            margin-top: 20px;
            border-radius: 5px;
            cursor: pointer;
        }

        .categories {
            text-align: center;
            padding: 25px;
        }

        .categories button {
            padding: 10px 20px;
            margin: 8px;
            background: #222;
            color: white;
            border: none;
            border-radius: 20px;
            cursor: pointer;
        }

        .categories button:hover {
            background: orange;
        }

        .products {
            padding: 20px 5%;
        }

        .products h2 {
            text-align: center;
            margin-bottom: 25px;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .card {
            background: white;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            box-shadow: 0 2px 8px #ddd;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px #bbb;
        }

        .card img {
            width: 100%;
            height: 180px;
            object-fit: contain;
        }

        .card h3 {
            margin: 12px 0;
        }

        .description {
            color: #666;
            font-size: 14px;
            margin: 10px 0;
        }

        .rating {
            color: #ff9800;
            margin: 8px 0;
        }

        .price {
            color: green;
            font-size: 20px;
            font-weight: bold;
        }

        .old-price {
            color: gray;
            text-decoration: line-through;
            font-size: 14px;
        }

        .discount {
            color: red;
            font-size: 14px;
        }

        .card button {
            width: 100%;
            padding: 10px;
            margin-top: 10px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .cart {
            background: orange;
            color: white;
        }

        .buy {
            background: #222;
            color: white;
        }

        .card button:hover {
            opacity: 0.8;
        }

        footer {
            background: #222;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 30px;
        }

        @media (max-width: 900px) {
            .product-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 500px) {
            nav {
                flex-direction: column;
            }

            nav a {
                margin: 5px;
            }

            .banner h1 {
                font-size: 25px;
            }

            .product-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <nav>
        <h2>ShopEasy</h2>

        <div>
            <a href="#">Home</a>
            <a href="#products">Products</a>
            <a href="#categories">Categories</a>
            <a href="#contact">Contact</a>
            <a href="#cart">Cart</a>
        </div>

        <div class="search">
            <input type="text" placeholder="Search products...">
        </div>
    </nav>

    <section class="banner">
        <h1>Big Shopping Festival!</h1>
        <p>Get up to 50% OFF on selected products.</p>
        <button onclick="location.href='#products'">
            Shop Now
        </button>
    </section>

    <section class="categories" id="categories">
        <h2>Shop by Category</h2>

        <button>Electronics</button>
        <button>Fashion</button>
        <button>Accessories</button>
        <button>Footwear</button>
    </section>

    <section class="products" id="products">
        <h2>Featured Products</h2>

        <div class="product-grid">

            <div class="card">
                <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=400"
                     alt="Headphones">

                <h3>Wireless Headphones</h3>
                <p class="description">
                    High-quality sound with comfortable design.
                </p>

                <p class="rating">4.5</p>
                <p class="price">₹1,499</p>
                <p class="old-price">₹2,999</p>
                <p class="discount">50% OFF</p>

                <button class="cart" onclick="alert('Added to Cart!')">
                    Add to Cart
                </button>

                <button class="buy" onclick="alert('Order Placed!')">
                    Buy Now
                </button>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400"
                     alt="Watch">

                <h3>Smart Watch</h3>
                <p class="description">
                    Stylish smartwatch with fitness tracking.
                </p>

                <p class="rating">4.8</p>
                <p class="price">₹2,499</p>
                <p class="old-price">₹4,999</p>
                <p class="discount">50% OFF</p>

                <button class="cart" onclick="alert('Added to Cart!')">
                    Add to Cart
                </button>

                <button class="buy" onclick="alert('Order Placed!')">
                    Buy Now
                </button>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400"
                     alt="Shoes">

                <h3>Sports Shoes</h3>
                <p class="description">
                    Lightweight shoes for daily activities.
                </p>

                <p class="rating">4.3</p>
                <p class="price">₹1,999</p>
                <p class="old-price">₹3,999</p>
                <p class="discount">50% OFF</p>

                <button class="cart" onclick="alert('Added to Cart!')">
                    Add to Cart
                </button>

                <button class="buy" onclick="alert('Order Placed!')">
                    Buy Now
                </button>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=400"
                     alt="Camera">

                <h3>Digital Camera</h3>
                <p class="description">
                    Capture beautiful photos and memories.
                </p>

                <p class="rating">4.7</p>
                <p class="price">₹5,999</p>
                <p class="old-price">₹9,999</p>
                <p class="discount">40% OFF</p>

                <button class="cart" onclick="alert('Added to Cart!')">
                    Add to Cart
                </button>

                <button class="buy" onclick="alert('Order Placed!')">
                    Buy Now
                </button>
            </div>

        </div>
    </section>

    <footer id="contact">
        <h3>ShopEasy Online Store</h3>
        <p>Contact: support@shopeasy.com</p>
        <p>© 2026 ShopEasy. All Rights Reserved.</p>
    </footer>

</body>
</html>
